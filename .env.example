# Copy to .env on each workstation and fill in local-only values.
# Never commit .env.

GLADOS_RUNTIME_DIR=$HOME/.glados

GLADOS_AGENT_WORKSPACES=$HOME/.glados/workspaces/agents
GLADOS_REPORTS_DIR=$HOME/.glados/reports
GLADOS_INVESTIGATIONS_DIR=$HOME/.glados/investigations
GLADOS_OPERATOR_CONTEXT=$HOME/.glados/operator-context.json
GLADOS_LOCAL_AUTH=$HOME/.glados/secrets/local-auth.json
BLACKBOARD_DB=$HOME/.glados/blackboard/blackboard.db
WATCHDOG_DB=$HOME/.glados/watchdog/watchdog.db

ANTHROPIC_BASE_URL=https://llmapi.redteamstuff.com
# Store the key with scripts/setup-llm-secret.sh. Do not put it in this file.
GLADOS_PRIMARY_MODEL=claude-sonnet-5
GLADOS_DISABLE_OLLAMA=1
GLADOS_BROWSER_MCP=1
GLADOS_PROXY_BACKEND=mitmproxy
GLADOS_MITM_LISTEN_HOST=127.0.0.1
GLADOS_MITM_LISTEN_PORT=18080
GLADOS_PROXY_RETENTION_DAYS=14
GLADOS_PROXY_RETENTION_MAX_FILES=40
GLADOS_PROXY_RETENTION_MAX_BYTES=1073741824
GLADOS_PROXY_MAX_JSONL_BYTES=67108864
GLADOS_PROXY_RAW_FLOWS=0

PORT=0
