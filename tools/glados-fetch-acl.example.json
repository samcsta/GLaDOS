{
  "_comment": "GLaDOS v4 per-agent target ACL. Copy to ~/.glados/policy/glados-fetch-acl.json. The Agent SDK PreToolUse gate reads it for target-capable tools. Leave enabled=false until an operator-approved plan populates it.",
  "version": 1,
  "enabled": false,
  "default": "deny",
  "agents": {
    "osint": {
      "allow": [
        "*.shodan.io",
        "*.censys.io",
        "crt.sh",
        "*.crt.sh",
        "api.github.com",
        "*.github.com",
        "archive.org",
        "web.archive.org",
        "*.virustotal.com"
      ]
    },
    "origin-ip": {
      "allow": [
        "*.shodan.io",
        "*.censys.io",
        "*.fofa.info",
        "dns.google",
        "cloudflare-dns.com"
      ]
    },
    "net-recon": {
      "allow": [
        "dns.google",
        "cloudflare-dns.com"
      ]
    },
    "webapp-recon": {
      "allow": [
        "__FILL_TARGET_HOSTS__"
      ]
    },
    "webapp-vuln": {
      "allow": [
        "__FILL_TARGET_HOSTS__"
      ]
    },
    "api-expert": {
      "allow": [
        "__FILL_TARGET_HOSTS__"
      ]
    }
  }
}
